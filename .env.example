DB_SERVER=YOUR_COMPUTER\YOUR_SQL_INSTANCE
DB_DATABASE=LocalHandsDB
DB_DRIVER=ODBC Driver 18 for SQL Server

# Playwright isolated test database (never point this at the demo database)
LH_TEST_DB_SERVER=YOUR_TEST_SQL_SERVER_INSTANCE
LH_TEST_DB_DATABASE=LocalHandsDB_Test
LH_TEST_DB_DRIVER=ODBC Driver 18 for SQL Server
# Synthetic test-only account passwords; replace locally with 12-128 character values
LH_TEST_CUSTOMER_PASSWORD=CHANGE_ME_TEST_ONLY_CUSTOMER_PASSWORD
LH_TEST_WORKER_PASSWORD=CHANGE_ME_TEST_ONLY_WORKER_PASSWORD
LH_TEST_ADMIN_PASSWORD=CHANGE_ME_TEST_ONLY_ADMIN_PASSWORD
